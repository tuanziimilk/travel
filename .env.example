OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=your_gemini_api_key

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
TRANSLATION_AI_MODEL=gemini-2.5-flash-lite
CATEGORY_CALIBRATION_AI_MODEL=gemini-2.5-flash-lite
AI_COST_AUTO_MATCH=true
AI_TEMPERATURE=0
AI_RESPONSE_FORMAT_MODE=json_object
AI_MAX_OUTPUT_TOKENS=1200
AI_PROMPT_VERSION=about_quality_scoring_v1
AI_INPUT_COST_PER_1M=0.10
AI_OUTPUT_COST_PER_1M=0.40
ABOUT_SKILL_PATH=skills/about-quality-scoring
FAQ_SKILL_PATH=skills/faq-quality-scoring

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=about_quality
DATABASE_URL=mysql://root:password@127.0.0.1:3306/about_quality_demo
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
SNAPSHOT_ENABLED=true
INGEST_ROW_CONCURRENCY=14
INGEST_ADAPTIVE_THROTTLE_ENABLED=true
INGEST_FAILURE_STREAK_THRESHOLD=3
INGEST_THROTTLE_MS=1200
INGEST_PROGRESS_FLUSH_MS=1000
INGEST_ROW_MAX_RETRIES=1
INGEST_ROW_RETRY_BASE_MS=500
INGEST_ROW_RETRY_MAX_MS=5000
INGEST_FINAL_RETRY_PASSES=1
INGEST_FINAL_RETRY_CONCURRENCY=6
INGEST_JOB_STALL_MS=1200000

AI_HTTP_MAX_RETRIES=1
AI_HTTP_RETRY_BASE_MS=500
AI_HTTP_RETRY_MAX_MS=5000
AI_REQUEST_TIMEOUT_MS=60000
AI_REQUEST_TIMEOUT_MS_BATCH=90000
AI_EXECUTOR_MAX_RETRIES=1
NODE_OPTIONS=--max-old-space-size=2048

TRANSLATION_JOB_CONCURRENCY=1
TRANSLATION_REALTIME_CHUNK_CONCURRENCY=3
TRANSLATION_MEMORY_LOG_ENABLED=true
TRANSLATION_MEMORY_LOG_INTERVAL_MS=30000

# deploy.sh
DEPLOY_SERVER_USER=root
DEPLOY_SERVER_HOST=YOUR_SERVER_IP
DEPLOY_SERVER_DIR=/app/site/SC-quality-scoring
DEPLOY_SSH_KEY=
