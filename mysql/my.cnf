[mysqld]
# single-node deployment: avoid binlog disk growth during large FAQ batches
skip-log-bin
# ── 内存核心 ──────────────────────────────────────────
# InnoDB 缓冲池：最大内存消耗来源，调小至 192M
innodb_buffer_pool_size        = 192M
innodb_buffer_pool_instances   = 1
innodb_log_file_size           = 32M
innodb_flush_log_at_trx_commit = 2     # 稍微放宽持久性换性能

# 关闭 performance_schema，节省 ~80-150MB
performance_schema             = OFF

# ── 连接与线程 ────────────────────────────────────────
max_connections                = 50    # API 连接池默认 10，50 足够
thread_stack                   = 192K
thread_cache_size              = 8

# ── 查询缓冲 ─────────────────────────────────────────
sort_buffer_size               = 1M
read_buffer_size               = 1M
read_rnd_buffer_size           = 512K
join_buffer_size               = 1M
tmp_table_size                 = 32M
max_heap_table_size            = 32M

# ── 日志 ─────────────────────────────────────────────
slow_query_log                 = 0     # 生产稳定后可开启
